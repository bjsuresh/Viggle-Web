# Viggle project API key from https://portal.viggle.ai/keys  (NEVER ship this inside the mobile app)
VIGGLE_API_KEY=vg_xxxxxxxxxxxxxxxxx
VIGGLE_BASE_URL=https://apis.viggle.ai/v1

# Shared secret the mobile app must send as "x-app-token". Leave empty to disable (dev only).
APP_ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional: enables AI story scripting with Claude. Without it a built-in template planner is used.
ANTHROPIC_API_KEY=

PORT=3000
# Comma separated list of allowed CORS origins ("*" for all). Capacitor apps use capacitor://localhost and http://localhost
CORS_ORIGINS=*
# Max upload size in MiB accepted from the app (Viggle max is 100 MiB per video)
MAX_UPLOAD_MIB=100
# Where stitched story videos are written
OUTPUT_DIR=./output
